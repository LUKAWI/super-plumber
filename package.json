{
  "name": "super-plumber",
  "version": "0.1.0",
  "description": "工作流拓扑图管理工具（Super Plumber）— 将任务文档重构为 agent 可原生理解的拓扑结构",
  "type": "module",
  "bin": {
    "graph": "./dist/cli/index.js",
    "graph-mcp": "./dist/mcp/server.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/types.js"
  },
  "files": ["dist/", "web-ui/dist/"],
  "license": "MIT",
  "keywords": ["topology", "workflow", "graph", "yaml", "mcp", "agent"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
